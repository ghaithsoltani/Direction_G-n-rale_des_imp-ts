{
  "info": {
    "name": "DGI Immatriculation API",
    "description": "🚀 Collection DGI - Ordre de test :\\n1. Login Admin (password123) → auto-remplit {{adminToken}}\\n2. Register Agent → crée agent@dgi.tn\\n3. Register User → auto-remplit {{token}}\\n4. Create PP → auto-remplit {{contribuableId}}\\n5. Create Dossier → auto-remplit {{dossierId}}\\n6. Upload Doc → auto-remplit {{pieceId}}\\n7. Test OCR / Face / Chatbot\\n\\n⚠️ AVANT : exécutez cette commande SQL :\\ndocker exec -it dgi-postgres psql -U dgi_user -d dgi_immatriculation -c \"INSERT INTO utilisateurs (id, email, mot_de_passe_hash, role, actif, date_creation) VALUES (gen_random_uuid(), 'admin@dgi.tn', '\\$2a\\$10\\$BEEYZbMp349RkEh2REvIwOMtwbFqQ5FN0vgBOegowWmFOHaFY2Gqe', 'ADMIN', true, now());\"",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 1. AUTH",
      "item": [
        {
          "name": "1.1 Login Admin (password123)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8081/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@dgi.tn\",\n  \"motDePasse\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('adminToken', jsonData.token);",
                  "    pm.collectionVariables.set('adminId', jsonData.contribuableId || '');",
                  "    console.log('✅ adminToken stocké');",
                  "} else {",
                  "    console.log('❌ Login admin échoué:', pm.response.text());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 Register Agent (ADMIN only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "http://localhost:8081/api/auth/register-agent",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agent@dgi.tn\",\n  \"motDePasse\": \"agent123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('agentToken', jsonData.token);",
                  "    pm.collectionVariables.set('agentId', jsonData.contribuableId || '');",
                  "    console.log('✅ Agent créé + agentToken stocké');",
                  "} else {",
                  "    console.log('⚠️ Agent existe peut-être déjà (code ' + pm.response.code + ')');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
