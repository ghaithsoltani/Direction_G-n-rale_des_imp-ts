    {
      "name": "📁 3. DOSSIERS",
      "item": [
        {
          "name": "3.1 Create Dossier",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "http://localhost:8081/api/dossiers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contribuableId\": \"{{contribuableId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('dossierId', jsonData.id);",
                  "console.log('✅ dossierId =', jsonData.id);",
                  "console.log('📋 Numéro =', jsonData.numeroDossier);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3.2 Get by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "http://localhost:8081/api/dossiers/{{dossierId}}"
          }
        },
        {
          "name": "3.3 List by Contribuable",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "http://localhost:8081/api/dossiers/contribuable/{{contribuableId}}"
          }
        },
        {
          "name": "3.4 List Paginated (Agent)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agentToken}}"
              }
            ],
            "url": "http://localhost:8081/api/dossiers?statut=BROUILLON&page=0&size=10"
          }
        },
        {
          "name": "3.5 Submit Dossier",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "http://localhost:8081/api/dossiers/{{dossierId}}/soumettre?auteurId={{userId}}"
          }
        },
        {
          "name": "3.6 Change Status (Agent)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{agentToken}}"
              }
            ],
            "url": "http://localhost:8081/api/dossiers/{{dossierId}}/statut",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nouveauStatut\": \"EN_TRAITEMENT\",\n  \"commentaire\": \"Pièces vérifiées\"\n}"
            }
          }
        },
        {
          "name": "3.7 Upload Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "http://localhost:8081/api/dossiers/{{dossierId}}/documents?typePiece=CIN_RECTO",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "typePiece",
                  "value": "CIN_RECTO",
                  "type": "text"
                },
                {
                  "key": "fichier",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('pieceId', jsonData.id);",
                  "    console.log('✅ pieceId =', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3.8 Download Document",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "http://localhost:8081/api/dossiers/{{dossierId}}/documents/{{pieceId}}"
          }
        },
        {
          "name": "3.9 Delete Document",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "http://localhost:8081/api/dossiers/{{dossierId}}/documents/{{pieceId}}"
          }
        }
      ]
