                  "    pm.collectionVariables.set('agentToken', jsonData.token);",
                  "    pm.collectionVariables.set('agentId', jsonData.contribuableId || '');",
                  "    console.log('✅ agentToken stocké');",
                  "} else {",
                  "    console.log('❌ Login agent échoué:', pm.response.text());",
