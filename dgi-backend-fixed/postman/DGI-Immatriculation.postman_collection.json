    {
      "name": "👤 2. CONTRIBUABLES",
      "item": [
        {
          "name": "2.1 Create Personne Physique",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "http://localhost:8081/api/contribuables",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"PERSONNE_PHYSIQUE\",\n  \"cin\": \"12345678\",\n  \"email\": \"contribuable@test.tn\",\n  \"telephone\": \"20123456\",\n  \"nom\": \"Ben Salah\",\n  \"prenom\": \"Ali\",\n  \"dateNaissance\": \"1990-01-01\",\n  \"lieuNaissance\": \"Tunis\",\n  \"nationalite\": \"Tunisienne\",\n  \"genre\": \"HOMME\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('contribuableId', jsonData.id);",
                  "console.log('✅ contribuableId =', jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.2 Create Personne Morale",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "http://localhost:8081/api/contribuables",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"PERSONNE_MORALE\",\n  \"email\": \"societe@test.tn\",\n  \"telephone\": \"71234567\",\n  \"raisonSociale\": \"SARL Test\",\n  \"registreCommerce\": \"B123456789\",\n  \"formeJuridique\": \"SARL\",\n  \"representantNom\": \"Ben Salah\",\n  \"representantPrenom\": \"Ali\",\n  \"representantCin\": \"12345678\"\n}"
            }
          }
        },
        {
          "name": "2.3 Get by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
